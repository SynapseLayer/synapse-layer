# ============================================================================
# Synapse Layer — Auto-Save MCP Bridge: Environment Configuration
# Copy to .env and fill in your values
# ============================================================================

# ── Supabase ────────────────────────────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...   # SERVICE_ROLE key — NEVER expose to clients

# ── Embeddings ──────────────────────────────────────────────────────────────
EMBEDDING_PROVIDER=openai          # openai | local
OPENAI_API_KEY=sk-...              # Required if EMBEDDING_PROVIDER=openai
# LOCAL_MODEL=all-MiniLM-L6-v2     # Used if EMBEDDING_PROVIDER=local

# ── Projects (comma-separated allowlist) ────────────────────────────────────
ALLOWED_PROJECTS=OFFLY,SYNAPSE_LAYER,GOARQIA,NEXUMI,SAFEZAP_BRASIL

# ── Security ────────────────────────────────────────────────────────────────
REDACTION_LEVEL=strict             # strict | standard
LOG_LEVEL=INFO                     # DEBUG | INFO | WARNING | ERROR

# ── Rate Limiting ───────────────────────────────────────────────────────────
RATE_LIMIT_PER_MINUTE=60           # Max save_to_synapse calls per minute

# ── Synapse Mode ────────────────────────────────────────────────────────────
SYNAPSE_MODE=oss                   # oss | pro
