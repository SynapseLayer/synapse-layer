# Synapse Layer — Secure Memory MCP Server
# Copy this file to .env and adjust values as needed.

# Unique identifier for this agent's memory namespace
SYNAPSE_AGENT_ID=mcp-secure-memory

# Differential-privacy epsilon (lower = stronger privacy, higher = better recall)
# Recommended range: 0.1 (max privacy) — 1.0 (balanced)
SYNAPSE_PRIVACY_EPSILON=0.5

# Logging level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
