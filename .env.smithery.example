# =============================================================================
# Synapse Layer — Environment Variables for Forge Server (v2.4.0)
# =============================================================================
# These variables are required on the production server (forge.synapselayer.org)
# that backs the Smithery MCP endpoint.
#
# NOTE: Smithery proxies requests to forge.synapselayer.org/api/mcp.
#       These vars are NOT configured on Smithery — they live on YOUR server.
# =============================================================================

# ── Database ──────────────────────────────────────────────────
DATABASE_URL=postgresql://...
DIRECT_URL=postgresql://...

# ── Auth ──────────────────────────────────────────────────────
NEXTAUTH_SECRET=...

# ── Encryption (AES-256-GCM at rest) ─────────────────────────
SYNAPSE_ENCRYPTION_KEY=...
SYNAPSE_HMAC_KEY=...

# ── Embeddings (pgvector HNSW) ────────────────────────────────
OPENAI_API_KEY=...

# ── MCP Feature Flags ─────────────────────────────────────────
MCP_TOOL_DELETE_MEMORY_ENABLED=false
ADMIN_TOKEN=...

# ── Optional ──────────────────────────────────────────────────
# CRON_SECRET=...         (for GC cron)
# TELEGRAM_TOKEN=...      (for Telegram bot)
# STRIPE_SECRET_KEY=...   (for billing)
